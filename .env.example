# Fireworks AI — server-only key for the site chat assistant
FIREWORKS_API_KEY=

# n8n webhook URL for contact + chat lead form submissions
N8N_FORMS=

# Cloudflare Turnstile (site key is public; secret stays server-only)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Canonical origin for sitemap.xml, robots.txt, and Payload CSRF (no trailing slash)
# Production is served at grandriverlabs.io — keep this in sync with the live domain.
SITE_URL=https://grandriverlabs.io

# Payload CMS (Postgres + admin secret)
# Local Docker: postgresql://payload:payload@localhost:5432/payload
# Railway from your laptop: use DATABASE_PUBLIC_URL, not *.railway.internal
# Example: postgresql://postgres:...@xxxxx.proxy.rlwy.net:PORT/railway?sslmode=require
DATABASE_URL=postgresql://payload:payload@localhost:5432/payload
# Override SSL auto-detect (on for remote hosts, off for localhost)
# DATABASE_SSL=true
# openssl rand -hex 32 — keep this stable; changing it invalidates admin sessions
PAYLOAD_SECRET=
# Public origin Payload should treat as itself (defaults to SITE_URL in production)
# PAYLOAD_SERVER_URL=https://grandriverlabs.io
# Extra comma-separated origins allowed to send the admin cookie (www, preview URLs, etc.)
# PAYLOAD_CSRF_ORIGINS=https://www.grandriverlabs.io

# S3-compatible media storage (Railway bucket, R2, etc.)
# Railway buckets are private — Payload proxies files through /api/media/file
# From the bucket Credentials tab, or `railway bucket credentials --json`
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://storage.railway.app
S3_REGION=auto
# Railway uses virtual-hosted URLs. Set true only if the Credentials tab says path-style.
S3_FORCE_PATH_STYLE=false
